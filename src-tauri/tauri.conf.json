{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cell Culture Recorder",
  "version": "0.1.5",
  "identifier": "com.zhuojian.cell-culture-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cell Culture Recorder",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhuojianlook/cell-culture-recorder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMkEzQ0U3MkI0OUY5NDMKUldSRCtVa3I1endxcnZ2d2xkV3JYdlBJQ21kbkt6cUtrTWdEZjJIMmgrVHVsM0VFelZta3Bva3AK"
    },
    "sql": {
      "preload": ["sqlite:cell-culture-recorder.db"]
    }
  }
}
