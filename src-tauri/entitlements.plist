<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Required so the bundled Node (V8) sidecar can JIT-compile inside a signed,
    Gatekeeper-restricted .app on Apple Silicon. Without allow-jit /
    allow-unsigned-executable-memory, V8 fails to reserve executable memory
    ("Failed to reserve virtual memory for CodeRange") and the sidecar is killed
    on startup (SIGTRAP), so the local server never comes up.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
